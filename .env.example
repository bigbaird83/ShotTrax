# Share-sync Worker (JSON PUT/GET host).
# - Live share link refresh (share still works without this — the snapshot
#   is encoded in the URL).
# - Course search, nearby, scorecard, GCA Pro greens, and golfapi.io
#   last-resort paint all go through this Worker ({url}/gca/v1/…,
#   {url}/golfapi/v2.3/…). Unset → bundled catalog only, never invented.
#
# Vendor keys are NOT app env. Set them on the Worker as Cloudflare secrets:
#   wrangler secret put GOLF_COURSES_API_KEY
#   wrangler secret put GOLFAPI_KEY
# See worker-golf-proxy.js. Never put them in .env, EAS env, or app extra.
EXPO_PUBLIC_SHARE_SYNC_URL=

# Optional shared course-paint cache (JSON GET/PUT /{key}).
# Not a secret. Unset → on-device SQLite only (settings key course.paint.cache).
# Keys: id:<courseId> and name:<name>|<city>|<state>
# A PASS from OSM, GCA Pro, or golfapi is written here so the next device
# does not call GCA green-centers or golfapi again.
EXPO_PUBLIC_COURSE_PAINT_CACHE_URL=

# RevenueCat iOS public SDK key (appl_…). Not a secret, but do not commit a
# value. Set EXPO_PUBLIC_REVENUECAT_IOS_KEY on expo.dev for EAS builds.
# Empty here means the app does not configure RevenueCat and Pro stays off.
# No paywall and no locks in this build. The Watch app does not use it.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# TEMP: Yard Test course (on-device QA).
# EXPO_PUBLIC_DEBUG_YARD_COURSE=1 → expo.extra.debugYardCourse.
# Absent on any profile, including production, leaves the course off.
# REMOVE BEFORE APP STORE SUBMISSION — delete that one line from eas.json
# build.production.env. __DEV__ does not need the flag. Settings → "Yard test course"
# stays hidden until unlocked, and the switch defaults off.
#
# EXPO_PUBLIC_YARD_TEST_COURSE is JSON copied into expo.extra.yardTestCourse.
# Shape: {"center":{"lat":number,"lng":number},"tee":{"lat":number,"lng":number},"green":{"lat":number,"lng":number},"par":3|4|5}
# The value below is a synthetic placeholder only. Replace it outside the repo.
# Missing or malformed → the course is unavailable. The 1-mile radius stays in code.
EXPO_PUBLIC_DEBUG_YARD_COURSE=
EXPO_PUBLIC_YARD_TEST_COURSE={"center":{"lat":0,"lng":1},"tee":{"lat":0,"lng":1},"green":{"lat":0,"lng":1.001},"par":4}
