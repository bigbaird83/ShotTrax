# Golf Courses API
# Nearby picker, hole par, and green centroids (P5 part 2).
# Never commit a real key.
#
# EAS (production / preview / development): create secret GOLF_COURSES_API_KEY.
# app.config.js copies it into expo.extra.golfCoursesApiKey at build time.
# Do not invent a second EAS secret name in git.
#
# Local Expo Go also needs a public prefix (Metro inlines EXPO_PUBLIC_*):
EXPO_PUBLIC_GOLF_COURSES_API_KEY=
# Optional local alias of the EAS secret name (read by app.config.js):
GOLF_COURSES_API_KEY=

# golfapi.io runtime tee/green for courses that are not bundled.
# First miss fetches once and caches on-device; replay is cache-only.
# EAS (production / preview / development): create secret GOLFAPI_KEY
# (same name as GitHub Actions). app.config.js copies it into extra.golfApiKey.
# Never commit a real key. Thin GPS / no key stays a miss — never invented.
EXPO_PUBLIC_GOLFAPI_KEY=
GOLFAPI_KEY=

# Optional JSON PUT/GET host so a live share link can refresh.
# Share still works without this — the snapshot is encoded in the URL.
EXPO_PUBLIC_SHARE_SYNC_URL=

# Optional shared course-paint cache (JSON GET/PUT /{key}).
# Not a secret. Unset → on-device SQLite only (settings key course.paint.cache).
# Keys: id:<courseId> and name:<name>|<city>|<state>
# A PASS from OSM, GCA Pro, or golfapi is written here so the next device
# does not call GCA green-centers or golfapi again.
EXPO_PUBLIC_COURSE_PAINT_CACHE_URL=
