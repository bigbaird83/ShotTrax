{
  "expo": {
    "name": "ShotTrax",
    "slug": "shottrax",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shottrax",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ShotTrax captures GPS when you confirm a club to start a shot, and again on the next mark to measure yards."
      },
      "bundleIdentifier": "com.shottrax.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1A12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1A12"
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ShotTrax captures GPS when you confirm a club to start a shot, and again on the next mark to measure yards."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
