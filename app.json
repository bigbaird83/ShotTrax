{
  "expo": {
    "name": "ShotTraxx™",
    "slug": "shottrax",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shottrax",
    "owner": "bigbaird83",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shottrax.app",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.shottrax.app"]
      },
      "infoPlist": {
        "CFBundleDisplayName": "ShotTraxx™",
        "CFBundleName": "ShotTraxx™",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "ShotTraxx™ uses your location while the app is open to find courses near you, show yards to the green, and mark where you hit from when you pick a club.",
        "NSPhotoLibraryUsageDescription": "ShotTraxx™ does not use your photo library except to read one scorecard photo you pick when you add a course.",
        "NSCameraUsageDescription": "ShotTraxx™ uses the camera only when you take a photo of a paper scorecard to add a course.",
        "NSPhotoLibraryAddUsageDescription": "ShotTraxx™ does not save photos to your library. This description is required to ship on the App Store.",
        "NSHealthShareUsageDescription": "ShotTraxx™ does not read your Health data. It uses Health only to keep your round running on your Apple Watch.",
        "NSHealthUpdateUsageDescription": "ShotTraxx™ uses a golf workout on your Apple Watch only to keep the round running. It does not save the round to Health."
      }
    },
    "android": {
      "label": "ShotTraxx™",
      "adaptiveIcon": {
        "backgroundColor": "#05190D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withSplashContain",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000101",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#000101"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ShotTraxx™ uses your location while the app is open to find courses near you, show yards to the green, and mark where you hit from when you pick a club.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "motionUsagePermission": false
        }
      ],
      "./plugins/withDisableExpoLocationMotion",
      [
        "expo-image-picker",
        {
          "photosPermission": "ShotTraxx™ does not use your photo library except to read one scorecard photo you pick when you add a course.",
          "cameraPermission": "ShotTraxx™ uses the camera only when you take a photo of a paper scorecard to add a course.",
          "microphonePermission": false
        }
      ],
      "expo-mail-composer",
      "react-native-maps",
      "./plugins/withWatchWidgetEmbed",
      "./plugins/withWatchInfoPlist",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0db22db7-ae58-42c6-9be8-fb6b07201a05",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShotTraxxWatch",
                  "bundleIdentifier": "com.shottrax.app.watch",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.shottrax.app"],
                    "com.apple.developer.healthkit": true
                  }
                },
                {
                  "targetName": "ShotTraxxHole",
                  "bundleIdentifier": "com.shottrax.app.watch.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.shottrax.app"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
